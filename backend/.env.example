DATABASE_URL=postgres://realty:realty@localhost:5432/realty

# https://ads-api.ru account
ADS_API_USER=you@example.com
ADS_API_TOKEN=

# Key for the OpenAI-compatible API (variable name is vision.api_key_env in config.toml)
MY_AI_PROXY=

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=realty
S3_SECRET_KEY=realty-secret
S3_BUCKET=realty-images

# Linux only: send requests to listing sources through this interface,
# bypassing a VPN. The model API keeps normal routing.
# SOURCE_NETWORK_INTERFACE=wlan0
