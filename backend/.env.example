# Database
DATABASE_URL=postgres://realty:realty_dev_password@localhost:5432/realty

# ADS-API.ru credentials
ADS_API_USER=your@email.com
ADS_API_TOKEN=your_token_here

# OpenAI-compatible proxy for vision analysis (vision.api_key_env in config.toml)
MY_AI_PROXY=your_proxy_key_here

# MinIO S3 Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=realty
MINIO_SECRET_KEY=realty_dev_password
MINIO_BUCKET=realty-images

# Optional Linux physical interface for sources; model API keeps normal routing.
# SOURCE_NETWORK_INTERFACE=wlan0
