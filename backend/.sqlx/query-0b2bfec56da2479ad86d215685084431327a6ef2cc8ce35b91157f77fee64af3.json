{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, listing_id, image_index, source_url,\n                   status AS \"status: ImageStatus\", download_attempts\n            FROM images\n            WHERE status = 'pending'\n               OR (status = 'not_found' AND download_attempts < 2)\n            ORDER BY listing_id, image_index\n            LIMIT $1\n            ",
