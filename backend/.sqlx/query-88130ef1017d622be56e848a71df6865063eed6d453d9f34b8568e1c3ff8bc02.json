  "query": "\n            SELECT id, price, time_created as created_at\n            FROM listings\n            WHERE is_active = true\n              AND time_created < NOW() - INTERVAL '1 day' * $1::int\n            ORDER BY time_created ASC\n            LIMIT $2\n            ",
