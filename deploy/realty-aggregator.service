[Unit]
Description=Apartment collection and selection
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/okhsunrog/code/realty-aggregator/backend
EnvironmentFile=/home/okhsunrog/code/realty-aggregator/backend/.env
ExecStartPre=/usr/bin/docker compose -f /home/okhsunrog/code/realty-aggregator/docker-compose.yml up -d --wait --wait-timeout 60 postgres minio
ExecStart=/home/okhsunrog/code/realty-aggregator/deploy/run-backend.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
